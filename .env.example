# Default: local SQLite. The application creates its tables on startup.
DATABASE_URL=sqlite:///./data/platform.db
IMPORT_ROOT=./data/imports
DEMO_MODE=true
DEMO_BASE_URL=http://127.0.0.1:8000
HTTP_ALLOWED_HOSTS=127.0.0.1,localhost
SYNC_BATCH_SIZE=50
SOURCE_LEASE_SECONDS=300
